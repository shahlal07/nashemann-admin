# nashemann-admin — super-admin: apps, settlements, staff, RBAC, shared project brain
#
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
# Never commit .env.local. Vars marked "public" are exposed to the browser.

# --- App URLs (public) ---
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# --- Supabase ---
# See nashemann-web/CLAUDE.md: the platform layer is documented to use its own
# project (mztayodmvdpzzwzznsvu), separate from the commerce project used by
# vendor-storefronts/vendor-admins (eznxsosvsgkhexbjoolh).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# --- Vendor provisioning ---
# Base URL of vendor-admins. AGENTS.md documents vendor-admins on :3002.
VENDOR_PROVISION_URL=http://localhost:3002
VENDOR_PROVISION_SECRET=
# Shared secret for platform-to-vendor internal calls.
INTERNAL_PLATFORM_SECRET=

# --- Auth / cron ---
# Bearer secret required by the cron endpoints under /api/cron.
CRON_SECRET=

# --- Email ---
RESEND_API_KEY=
NASHEMANN_MAILER_URL=

# --- GitHub automation (server-side only, never expose to browser) ---
# Token needs repo scope for the issue/PR automation features.
GH_TOKEN=
GITHUB_TOKEN=

# --- AI ---
GROQ_API_KEY=
